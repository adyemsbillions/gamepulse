# Copy to .env.local and fill in. Only the publishable key goes here, never the secret/service_role key.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# GIFs and stickers in comments (free key: developers.giphy.com → Create an App → API). Optional.
EXPO_PUBLIC_GIPHY_KEY=
